// =============================================================================
// Vidyalaya — multi-tenant School ERP schema
//
// Tenancy rule: every row that belongs to a school carries `schoolId`. The
// tenant-scoped Prisma client (src/server/db.ts) injects `schoolId` into every
// query against these models, so application code cannot read or write another
// school's data by accident. Models without `schoolId` are platform-level.
//
// Money is Decimal(12,2). Human-facing document numbers (receipts, invoices,
// admission numbers) come from the per-school `Counter` table so they are
// sequential and gap-free within a school, as Indian auditors expect.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ==========================================

enum Role {
  PLATFORM_ADMIN // SaaS operator; manages tenants, never school data
  SUPER_ADMIN // School owner / director; full access, cannot be restricted
  ADMIN // Principal / campus administrator
  TEACHER
  ACCOUNTANT
  RECEPTIONIST
  LIBRARIAN
  TRANSPORT_MANAGER
  STORE_MANAGER
  STAFF
  PARENT
  STUDENT
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  PASSED_OUT
  DROPPED
}

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum PaymentMode {
  CASH
  UPI
  CARD
  NET_BANKING
  CHEQUE
  DD
  BANK_TRANSFER
  ONLINE
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  CANCELLED
  REFUNDED
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdmissionStage {
  ENQUIRY
  APPLIED
  DOCS_VERIFIED
  TEST_SCHEDULED
  SEAT_OFFERED
  ADMITTED
  REJECTED
  WITHDRAWN
}

// ======================= PLATFORM / TENANCY ==================================

model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?  @db.Text
  priceMonthly    Decimal  @default(0) @db.Decimal(12, 2)
  pricePerStudent Decimal  @default(0) @db.Decimal(12, 2)
  maxStudents     Int?
  maxCampuses     Int?
  modules         Json // string[] of module keys included in the plan
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schools School[]
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  DEMO_DONE
  CONVERTED
  CLOSED
}

/// "Start free trial / Book a demo" requests from the public website (src/website).
/// Platform-level: not tied to a school. Reviewed in the platform console.
model WebsiteLead {
  id          String            @id @default(cuid())
  interest    String            @default("trial") // trial | demo
  schoolName  String
  contactName String
  role        String?
  email       String
  phone       String
  city        String?
  state       String?
  board       String?
  students    String? // size band, e.g. "300 – 1,000"
  features    Json? // website feature slugs the visitor picked
  message     String?           @db.Text
  source      String? // page that sent the visitor
  status      WebsiteLeadStatus @default(NEW)
  notes       String?           @db.Text
  ip          String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model School {
  id                     String            @id @default(cuid())
  code                   String            @unique // entered on the login screen
  name                   String
  shortName              String?
  tagline                String?
  email                  String?
  phone                  String?
  website                String?
  address                String?           @db.Text
  city                   String?
  district               String?
  state                  String?
  pincode                String?
  country                String            @default("India")
  logoUrl                String?           @db.Text
  board                  String? // CBSE | ICSE | STATE | IB | CAMBRIDGE | OTHER
  affiliationNo          String?
  udiseCode              String?
  establishedYear        Int?
  timezone               String            @default("Asia/Kolkata")
  currency               String            @default("INR")
  currencySymbol         String            @default("₹")
  locale                 String            @default("en-IN")
  defaultLanguage        String            @default("en")
  academicYearStartMonth Int               @default(4)
  themeColor             String            @default("indigo")
  status                 SchoolStatus      @default(TRIAL)
  planId                 String?
  plan                   SubscriptionPlan? @relation(fields: [planId], references: [id])
  trialEndsAt            DateTime?
  subscriptionEndsAt     DateTime?
  settings               Json? // see src/server/settings.ts for the typed shape
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  campuses        Campus[]
  users           User[]
  modules         SchoolModule[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]

  @@index([status])
}

/// School-wide on/off switch for a module (customer customisation).
model SchoolModule {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  module    String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([schoolId, module])
}

/// Per-role override of the default permission matrix for one module.
model RolePermission {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role      Role
  module    String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([schoolId, role, module])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String?
  role      String?
  action    String // CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | EXPORT | ...
  entity    String
  entityId  String?
  summary   String?  @db.Text
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Atomic per-school sequence for receipt / invoice / admission numbers.
model Counter {
  schoolId String
  key      String
  value    Int    @default(0)

  @@id([schoolId, key])
}

model StoredFile {
  id         String   @id @default(cuid())
  schoolId   String
  uploadedBy String?
  purpose    String // PHOTO | DOCUMENT | HOMEWORK | LMS | LOGO | ATTACHMENT
  fileName   String
  mimeType   String
  size       Int
  path       String // relative to STORAGE_DIR, never web-served directly
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([schoolId, purpose])
}

// ============================ IDENTITY =======================================

model User {
  id                 String    @id @default(cuid())
  schoolId           String?
  school             School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String?
  campus             Campus?   @relation(fields: [campusId], references: [id])
  username           String
  email              String?
  phone              String?
  passwordHash       String
  role               Role
  name               String
  avatarUrl          String?   @db.Text
  language           String    @default("en")
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  sessionVersion     Int       @default(0) // bump to revoke every session of this user
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student           Student?
  employee          Employee?
  guardian          Guardian?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@index([schoolId, email])
  @@index([schoolId, phone])
}

model Consent {
  id         String        @id @default(cuid())
  schoolId   String
  guardianId String?
  studentId  String?
  purpose    String // DATA_PROCESSING | APAAR | PHOTO_PUBLICATION | SMS_WHATSAPP
  status     ConsentStatus @default(PENDING)
  version    String        @default("1")
  recordedBy String?
  ip         String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, guardianId])
}

// ======================= ORGANISATION ========================================

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?  @db.Text
  city      String?
  phone     String?
  email     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  classes   Class[]
  students  Student[]
  employees Employee[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // "2026-27"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Class {
  id           String   @id @default(cuid())
  schoolId     String
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id])
  name         String // Nursery, LKG, UKG, 1 … 12
  numericOrder Int
  monthlyFee   Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections      Section[]
  students      Student[]
  subjects      ClassSubject[]
  feeStructures FeeStructure[]

  @@unique([schoolId, campusId, name])
  @@index([schoolId])
}

model Section {
  id             String    @id @default(cuid())
  schoolId       String
  classId        String
  class          Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  capacity       Int       @default(40)
  room           String?
  classTeacherId String?
  classTeacher   Employee? @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  students        Student[]
  timetable       TimetableEntry[]
  assignments     TeacherAssignment[]
  attendanceMarks StudentAttendance[]

  @@unique([classId, name])
  @@index([schoolId])
}

model Subject {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  code       String
  type       String   @default("THEORY") // THEORY | PRACTICAL | BOTH
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())

  classes     ClassSubject[]
  assignments TeacherAssignment[]
  chapters    Chapter[]

  @@unique([schoolId, code])
}

model ClassSubject {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fullMarks Int     @default(100)
  passMarks Int     @default(33)

  @@unique([classId, subjectId])
  @@index([schoolId])
}

model TeacherAssignment {
  id         String   @id @default(cuid())
  schoolId   String
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([schoolId, employeeId])
}

model Chapter {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)

  @@index([schoolId, classId, subjectId])
}

// ============================ PEOPLE =========================================

model Guardian {
  id               String   @id @default(cuid())
  schoolId         String
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyCode       String?
  fatherName       String?
  fatherPhone      String?
  fatherEmail      String?
  fatherOccupation String?
  fatherEducation  String?
  motherName       String?
  motherPhone      String?
  motherOccupation String?
  motherEducation  String?
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?
  primaryPhone     String // used for SMS/WhatsApp and family lookup
  address          String?  @db.Text
  annualIncome     Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  students Student[]

  @@unique([schoolId, familyCode])
  @@index([schoolId, primaryPhone])
}

model Student {
  id                  String        @id @default(cuid())
  schoolId            String
  campusId            String
  campus              Campus        @relation(fields: [campusId], references: [id])
  userId              String?       @unique
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNo         String
  rollNo              String?
  firstName           String
  lastName            String?
  gender              Gender
  dob                 DateTime?     @db.Date
  bloodGroup          String?
  religion            String?
  caste               String?
  category            String? // GENERAL | OBC | SC | ST | EWS
  motherTongue        String?
  nationality         String        @default("Indian")
  aadhaarEnc          String?       @db.Text // AES-256-GCM; never returned by the API
  aadhaarLast4        String?
  apaarId             String?
  apaarConsent        ConsentStatus @default(PENDING)
  penNo               String? // UDISE+ Permanent Education Number
  photoUrl            String?       @db.Text
  identificationMark  String?
  medicalNotes        String?       @db.Text
  address             String?       @db.Text
  city                String?
  state               String?
  pincode             String?
  previousSchool      String?
  previousBoardRollNo String?
  isRte               Boolean       @default(false) // RTE Act 12(1)(c) free seat
  admissionDate       DateTime      @db.Date
  status              StudentStatus @default(ACTIVE)
  leftOn              DateTime?     @db.Date
  leavingReason       String?
  feeDiscountPercent  Decimal       @default(0) @db.Decimal(5, 2)
  notes               String?       @db.Text
  classId             String
  class               Class         @relation(fields: [classId], references: [id])
  sectionId           String
  section             Section       @relation(fields: [sectionId], references: [id])
  guardianId          String?
  guardian            Guardian?     @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  attendance            StudentAttendance[]
  invoices              FeeInvoice[]
  payments              FeePayment[]
  examMarks             ExamMark[]
  testMarks             ClassTestMark[]
  transport             StudentTransport?
  hostel                HostelAllocation[]
  gatePasses            GatePass[]
  incidents             DisciplineIncident[]
  remarks               StudentRemark[]
  onlineExamAttempts    OnlineExamAttempt[]
  placementApplications PlacementApplication[]
  alumnus               Alumnus?
  promotions            StudentPromotion[]
  documents             StudentDocument[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, status])
  @@index([schoolId, firstName])
}

model StudentDocument {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  fileId    String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
}

model StudentPromotion {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassId   String
  fromSectionId String
  toClassId     String
  toSectionId   String
  academicYear  String
  result        String   @default("PROMOTED") // PROMOTED | DETAINED | PASSED_OUT
  promotedById  String?
  createdAt     DateTime @default(now())

  @@index([schoolId, studentId])
}

model Employee {
  id               String       @id @default(cuid())
  schoolId         String
  campusId         String
  campus           Campus       @relation(fields: [campusId], references: [id])
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeCode     String
  firstName        String
  lastName         String?
  gender           Gender
  dob              DateTime?    @db.Date
  phone            String?
  email            String?
  photoUrl         String?      @db.Text
  designation      String
  department       String?
  isTeaching       Boolean      @default(false)
  qualification    String?
  experienceYears  Int?
  joiningDate      DateTime     @db.Date
  fatherSpouseName String?
  aadhaarEnc       String?      @db.Text
  aadhaarLast4     String?
  panNo            String?
  bankName         String?
  bankAccount      String?
  ifsc             String?
  uan              String? // EPF Universal Account Number
  address          String?      @db.Text
  bloodGroup       String?
  religion         String?
  basicSalary      Decimal      @default(0) @db.Decimal(12, 2)
  allowances       Decimal      @default(0) @db.Decimal(12, 2)
  deductions       Decimal      @default(0) @db.Decimal(12, 2)
  status           RecordStatus @default(ACTIVE)
  leftOn           DateTime?    @db.Date
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  classTeacherOf Section[]            @relation("ClassTeacher")
  assignments    TeacherAssignment[]
  attendance     EmployeeAttendance[]
  salaries       SalaryPayment[]
  timetable      TimetableEntry[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId, status])
}

// ============================ ADMISSIONS =====================================

model AdmissionApplication {
  id             String         @id @default(cuid())
  schoolId       String
  applicationNo  String
  stage          AdmissionStage @default(ENQUIRY)
  source         String         @default("WALK_IN") // WALK_IN | ONLINE | PHONE | REFERRAL | CAMPAIGN
  classId        String
  academicYear   String
  studentName    String
  gender         Gender?
  dob            DateTime?      @db.Date
  previousSchool String?
  guardianName   String
  guardianPhone  String
  guardianEmail  String?
  address        String?        @db.Text
  notes          String?        @db.Text
  followUpAt     DateTime?
  assignedToId   String?
  studentId      String?        @unique // set once admitted
  consentGiven   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([schoolId, applicationNo])
  @@index([schoolId, stage])
  @@index([schoolId, guardianPhone])
}

// ============================ ATTENDANCE =====================================

model StudentAttendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  source     String           @default("MANUAL") // MANUAL | CARD | BIOMETRIC | APP
  remarks    String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date, sectionId])
}

model EmployeeAttendance {
  id         String           @id @default(cuid())
  schoolId   String
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  inTime     String?
  outTime    String?
  source     String           @default("MANUAL")
  remarks    String?
  markedById String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([schoolId, date])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  schoolId     String
  applicantId  String // User id
  studentId    String?
  employeeId   String?
  leaveType    String // SICK | CASUAL | EARNED | FAMILY | OTHER
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, applicantId])
}

// ============================ TIMETABLE ======================================

model Period {
  id        String  @id @default(cuid())
  schoolId  String
  name      String
  startTime String // "08:00"
  endTime   String
  sortOrder Int
  isBreak   Boolean @default(false)

  entries TimetableEntry[]

  @@index([schoolId])
}

model Room {
  id       String @id @default(cuid())
  schoolId String
  name     String
  capacity Int?

  entries TimetableEntry[]

  @@unique([schoolId, name])
}

model TimetableEntry {
  id         String    @id @default(cuid())
  schoolId   String
  sectionId  String
  section    Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  day        Int // 1 = Monday … 7 = Sunday
  periodId   String
  period     Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId  String
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([sectionId, day, periodId])
  @@index([schoolId, employeeId, day, periodId])
}

// ============================ ACADEMICS ======================================

model Homework {
  id            String   @id @default(cuid())
  schoolId      String
  classId       String
  sectionId     String?
  subjectId     String
  title         String
  description   String   @db.Text
  attachmentId  String?
  assignedOn    DateTime @db.Date
  dueOn         DateTime @db.Date
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  submissions HomeworkSubmission[]

  @@index([schoolId, classId, assignedOn])
}

model HomeworkSubmission {
  id           String   @id @default(cuid())
  schoolId     String
  homeworkId   String
  homework     Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  content      String?  @db.Text
  attachmentId String?
  status       String   @default("SUBMITTED") // SUBMITTED | CHECKED | REDO
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())

  @@unique([homeworkId, studentId])
  @@index([schoolId])
}

model StudyMaterial {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  subjectId   String
  title       String
  description String?  @db.Text
  kind        String   @default("DOCUMENT") // DOCUMENT | VIDEO | LINK
  fileId      String?
  url         String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  @@index([schoolId, classId, subjectId])
}

model LiveClass {
  id           String   @id @default(cuid())
  schoolId     String
  title        String
  platform     String   @default("GOOGLE_MEET") // GOOGLE_MEET | ZOOM | TEAMS | JITSI | BIGBLUEBUTTON | OTHER
  meetingUrl   String   @db.Text // empty for BigBlueButton: each user gets a signed join link
  audience     String // ALL_STUDENTS | ALL_STAFF | CLASS | SECTION
  classId      String?
  sectionId    String?
  startsAt     DateTime
  durationMins Int      @default(40)
  message      String?  @db.Text
  hostId       String
  hostName     String
  createdAt    DateTime @default(now())

  @@index([schoolId, startsAt])
}

model Exam {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  academicYear String
  term         String? // TERM_1 | TERM_2 | ANNUAL | …
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  schedules ExamSchedule[]
  marks     ExamMark[]

  @@index([schoolId, academicYear])
}

model ExamSchedule {
  id        String    @id @default(cuid())
  schoolId  String
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  subjectId String
  date      DateTime? @db.Date
  startTime String?
  endTime   String?
  maxMarks  Decimal   @default(100) @db.Decimal(6, 2)
  passMarks Decimal   @default(33) @db.Decimal(6, 2)
  room      String?

  @@unique([examId, classId, subjectId])
  @@index([schoolId])
}

model ExamMark {
  id            String   @id @default(cuid())
  schoolId      String
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  subjectId     String
  marksObtained Decimal? @db.Decimal(6, 2)
  isAbsent      Boolean  @default(false)
  remarks       String?
  enteredById   String?
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId, subjectId])
  @@index([schoolId, examId, classId])
}

model GradeScale {
  id         String   @id @default(cuid())
  schoolId   String
  grade      String
  minPercent Decimal  @db.Decimal(5, 2)
  maxPercent Decimal  @db.Decimal(5, 2)
  gradePoint Decimal? @db.Decimal(4, 2)
  remark     String?
  isPass     Boolean  @default(true)

  @@index([schoolId])
}

model ClassTest {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  sectionId   String?
  subjectId   String
  title       String
  testDate    DateTime @db.Date
  maxMarks    Decimal  @db.Decimal(6, 2)
  createdById String
  createdAt   DateTime @default(now())

  marks ClassTestMark[]

  @@index([schoolId, classId, testDate])
}

model ClassTestMark {
  id        String    @id @default(cuid())
  schoolId  String
  testId    String
  test      ClassTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks     Decimal?  @db.Decimal(6, 2)
  isAbsent  Boolean   @default(false)
  remarks   String?

  @@unique([testId, studentId])
  @@index([schoolId])
}

model Question {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  subjectId   String
  chapterId   String?
  type        String // MCQ | SHORT | LONG | TRUE_FALSE | FILL_BLANK
  text        String   @db.Text
  options     Json?
  answer      String?  @db.Text
  marks       Decimal  @default(1) @db.Decimal(5, 2)
  difficulty  String   @default("MEDIUM")
  createdById String
  createdAt   DateTime @default(now())

  @@index([schoolId, classId, subjectId])
}

model QuestionPaper {
  id           String   @id @default(cuid())
  schoolId     String
  title        String
  classId      String
  subjectId    String
  durationMins Int      @default(180)
  totalMarks   Decimal  @db.Decimal(6, 2)
  instructions String?  @db.Text
  sections     Json // [{ title, questionIds: string[] }]
  createdById  String
  createdAt    DateTime @default(now())

  @@index([schoolId, classId, subjectId])
}

model BehaviourRating {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  term      String
  category  String // BEHAVIOUR | SKILL
  trait     String
  rating    Int // 1 … 5
  ratedById String
  updatedAt DateTime @updatedAt

  @@unique([studentId, term, category, trait])
  @@index([schoolId, term])
}

model Observation {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  kind            String   @default("NEUTRAL") // POSITIVE | NEGATIVE | NEUTRAL
  note            String   @db.Text
  observedOn      DateTime @db.Date
  createdById     String
  createdByName   String
  shareWithParent Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([schoolId, studentId])
}

// ============================ FEES ===========================================

model FeeHead {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  kind      String   @default("RECURRING") // RECURRING | ONE_TIME
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  structures FeeStructure[]

  @@unique([schoolId, name])
}

model FeeStructure {
  id            String   @id @default(cuid())
  schoolId      String
  academicYear  String
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeHeadId     String
  feeHead       FeeHead  @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(12, 2)
  frequency     String   @default("MONTHLY") // MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY | ONE_TIME
  months        Json? // number[] of calendar months (1-12) the head is billed in
  dueDay        Int      @default(10)
  lateFeeType   String   @default("NONE") // NONE | FIXED | PER_DAY
  lateFeeAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, academicYear, classId, feeHeadId])
}

model FeeConcession {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  feeHeadId String? // null = applies to every head
  kind      String // PERCENT | FIXED
  value     Decimal  @db.Decimal(12, 2)
  reason    String? // SIBLING | STAFF_WARD | MERIT | RTE | OTHER
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
}

model FeeInvoice {
  id              String        @id @default(cuid())
  schoolId        String
  invoiceNo       String
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period          String // "2026-10" for monthly billing; "X-<id>" for instant (ad-hoc) invoices
  title           String? // instant invoices: what the charge is for
  issueDate       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  lateFee         Decimal       @default(0) @db.Decimal(12, 2)
  previousBalance Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       FeeInvoiceItem[]
  allocations FeePaymentAllocation[]

  @@unique([schoolId, invoiceNo])
  @@unique([studentId, period])
  @@index([schoolId, status, dueDate])
}

model FeeInvoiceItem {
  id          String     @id @default(cuid())
  schoolId    String
  invoiceId   String
  invoice     FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHeadId   String?
  description String
  amount      Decimal    @db.Decimal(12, 2)
  discount    Decimal    @default(0) @db.Decimal(12, 2)

  @@index([schoolId])
}

model FeePayment {
  id               String        @id @default(cuid())
  schoolId         String
  receiptNo        String
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  amount           Decimal       @db.Decimal(12, 2)
  mode             PaymentMode
  status           PaymentStatus @default(SUCCESS)
  referenceNo      String?
  chequeNo         String?
  bankName         String?
  paidAt           DateTime      @default(now())
  collectedById    String?
  collectedByName  String?
  remarks          String?
  gateway          String?
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())

  allocations FeePaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId, paidAt])
  @@index([schoolId, studentId])
}

model FeePaymentAllocation {
  id        String     @id @default(cuid())
  schoolId  String
  paymentId String
  payment   FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal    @db.Decimal(12, 2)

  @@index([schoolId, invoiceId])
}

// ============================ ACCOUNTS & PAYROLL =============================

model AccountHead {
  id        String     @id @default(cuid())
  schoolId  String
  name      String
  type      LedgerType
  isSystem  Boolean    @default(false)
  createdAt DateTime   @default(now())

  entries LedgerEntry[]

  @@unique([schoolId, name, type])
}

model LedgerEntry {
  id          String       @id @default(cuid())
  schoolId    String
  campusId    String?
  headId      String
  head        AccountHead  @relation(fields: [headId], references: [id], onDelete: Restrict)
  type        LedgerType
  amount      Decimal      @db.Decimal(12, 2)
  date        DateTime     @db.Date
  description String
  mode        PaymentMode?
  referenceNo String?
  party       String? // paid to / received from
  source      String       @default("MANUAL") // MANUAL | FEE | SALARY | STORE
  sourceId    String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([schoolId, date])
  @@index([schoolId, source, sourceId])
}

model SalaryPayment {
  id          String      @id @default(cuid())
  schoolId    String
  slipNo      String
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  month       String // "2026-10"
  basic       Decimal     @db.Decimal(12, 2)
  allowances  Decimal     @default(0) @db.Decimal(12, 2)
  bonus       Decimal     @default(0) @db.Decimal(12, 2)
  deductions  Decimal     @default(0) @db.Decimal(12, 2)
  net         Decimal     @db.Decimal(12, 2)
  mode        PaymentMode
  referenceNo String?
  paidAt      DateTime    @default(now())
  remarks     String?
  paidById    String?
  createdAt   DateTime    @default(now())

  @@unique([schoolId, slipNo])
  @@unique([employeeId, month])
  @@index([schoolId, month])
}

// ============================ COMMUNICATION ==================================

model Notice {
  id            String    @id @default(cuid())
  schoolId      String
  title         String
  body          String    @db.Text
  category      String    @default("GENERAL") // GENERAL | EXAM | FEE | EVENT | HOLIDAY | URGENT
  audience      Json // { roles: Role[], classIds: string[] }
  isPinned      Boolean   @default(false)
  publishAt     DateTime  @default(now())
  expiresAt     DateTime?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([schoolId, publishAt])
}

model Notification {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([schoolId, userId, isRead])
}

model Conversation {
  id        String   @id @default(cuid())
  schoolId  String
  userAId   String // lower id of the pair
  userBId   String
  lastAt    DateTime @default(now())
  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@unique([schoolId, userAId, userBId])
  @@index([schoolId, userAId])
  @@index([schoolId, userBId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  schoolId       String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([schoolId, conversationId, createdAt])
}

model MessageTemplate {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  channel       String // SMS | WHATSAPP | EMAIL
  body          String   @db.Text
  dltTemplateId String? // TRAI DLT registration for Indian SMS
  createdAt     DateTime @default(now())

  @@unique([schoolId, name, channel])
}

model OutboundMessage {
  id                String   @id @default(cuid())
  schoolId          String
  channel           String // SMS | WHATSAPP | EMAIL
  subject           String? // EMAIL only
  recipient         String
  recipientName     String?
  body              String   @db.Text
  status            String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED
  provider          String?
  providerMessageId String?
  error             String?  @db.Text
  batchId           String?
  sentById          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@index([schoolId, batchId])
}

model Event {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  description String?   @db.Text
  kind        String    @default("EVENT") // EVENT | HOLIDAY | PTM | EXAM | ACTIVITY
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  location    String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([schoolId, startDate])
}

model Meeting {
  id              String   @id @default(cuid())
  schoolId        String
  requestedById   String
  requestedByName String
  withUserId      String
  withUserName    String
  studentId       String?
  topic           String
  agenda          String?  @db.Text
  mode            String   @default("IN_PERSON") // IN_PERSON | VIDEO | PHONE
  scheduledAt     DateTime
  durationMins    Int      @default(15)
  status          String   @default("REQUESTED") // REQUESTED | CONFIRMED | DECLINED | COMPLETED | CANCELLED
  meetingUrl      String?  @db.Text
  outcome         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, withUserId, scheduledAt])
  @@index([schoolId, requestedById])
}

// ============================ OPERATIONS =====================================

model Vehicle {
  id               String    @id @default(cuid())
  schoolId         String
  registrationNo   String
  model            String?
  capacity         Int
  driverName       String
  driverPhone      String
  driverLicenseNo  String?
  attendantName    String?
  attendantPhone   String?
  insuranceExpiry  DateTime? @db.Date
  fitnessExpiry    DateTime? @db.Date
  pucExpiry        DateTime? @db.Date
  permitExpiry     DateTime? @db.Date
  gpsDeviceId      String?
  /// Secret for GPS hardware / tracker apps posting positions (public ingest URL). Rotatable.
  trackingToken    String?   @unique
  /// Employee who drives this vehicle; may share live location from Driver mode without Transport rights.
  driverEmployeeId String?
  lastLat          Float?
  lastLng          Float?
  lastSpeedKmh     Float?
  lastHeading      Float?
  lastSeenAt       DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  routes    TransportRoute[]
  locations VehicleLocation[]
  trips     TransportTrip[]

  @@unique([schoolId, registrationNo])
}

/// Position history for live tracking (pruned after the school's retention period).
model VehicleLocation {
  id         String   @id @default(cuid())
  schoolId   String
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedKmh   Float?
  heading    Float?
  accuracyM  Float?
  source     String // DRIVER_APP | GPS_DEVICE
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([schoolId, vehicleId, recordedAt])
}

/// A pickup or drop run; stop-approach alerts are sent once per stop per trip.
model TransportTrip {
  id            String    @id @default(cuid())
  schoolId      String
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  routeId       String?
  kind          String // PICKUP | DROP
  startedById   String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  notifiedStops Json?

  @@index([schoolId, vehicleId, startedAt])
}

model TransportRoute {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stops      RouteStop[]
  passengers StudentTransport[]

  @@unique([schoolId, name])
}

model RouteStop {
  id         String         @id @default(cuid())
  schoolId   String
  routeId    String
  route      TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int
  pickupTime String?
  dropTime   String?
  monthlyFee Decimal        @default(0) @db.Decimal(12, 2)
  lat        Float?
  lng        Float?

  passengers StudentTransport[]

  @@index([schoolId, routeId])
}

model StudentTransport {
  id        String         @id @default(cuid())
  schoolId  String
  studentId String         @unique
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopId    String
  stop      RouteStop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  tripType  String         @default("BOTH") // PICKUP | DROP | BOTH
  createdAt DateTime       @default(now())

  @@index([schoolId, routeId])
}

model Book {
  id        String   @id @default(cuid())
  schoolId  String
  title     String
  author    String?
  isbn      String?
  publisher String?
  category  String?
  rackNo    String?
  copies    Int      @default(1)
  available Int      @default(1)
  createdAt DateTime @default(now())

  issues BookIssue[]

  @@index([schoolId, title])
}

model BookIssue {
  id           String    @id @default(cuid())
  schoolId     String
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrowerType String // STUDENT | EMPLOYEE
  borrowerId   String
  borrowerName String
  issuedOn     DateTime  @db.Date
  dueOn        DateTime  @db.Date
  returnedOn   DateTime? @db.Date
  fine         Decimal   @default(0) @db.Decimal(12, 2)
  issuedById   String

  @@index([schoolId, returnedOn])
  @@index([schoolId, borrowerId])
}

model ProductCategory {
  id       String @id @default(cuid())
  schoolId String
  name     String

  products Product[]

  @@unique([schoolId, name])
}

model Product {
  id         String           @id @default(cuid())
  schoolId   String
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String
  sku        String
  unit       String           @default("pcs")
  price      Decimal          @db.Decimal(12, 2)
  gstPercent Decimal          @default(0) @db.Decimal(5, 2)
  stock      Int              @default(0)
  reorderAt  Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  orderItems StoreOrderItem[]

  @@unique([schoolId, sku])
}

model StoreOrder {
  id           String      @id @default(cuid())
  schoolId     String
  orderNo      String
  studentId    String?
  customerName String
  subtotal     Decimal     @db.Decimal(12, 2)
  tax          Decimal     @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  mode         PaymentMode
  status       String      @default("PAID") // PAID | CANCELLED
  soldById     String
  createdAt    DateTime    @default(now())

  items StoreOrderItem[]

  @@unique([schoolId, orderNo])
  @@index([schoolId, createdAt])
}

model StoreOrderItem {
  id         String     @id @default(cuid())
  schoolId   String
  orderId    String
  order      StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  name       String
  qty        Int
  unitPrice  Decimal    @db.Decimal(12, 2)
  gstPercent Decimal    @db.Decimal(5, 2)
  lineTotal  Decimal    @db.Decimal(12, 2)

  @@index([schoolId])
}

model Asset {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  category    String
  quantity    Int
  unitCost    Decimal   @default(0) @db.Decimal(12, 2)
  location    String?
  condition   String    @default("GOOD") // GOOD | FAIR | POOR | DAMAGED
  purchasedOn DateTime? @db.Date
  supplier    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, category])
}

// ============================ DOCUMENTS ======================================

model CertificateTemplate {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  kind          String // TRANSFER | CHARACTER | BONAFIDE | MERIT | EXPERIENCE | CUSTOM
  recipientType String // STUDENT | EMPLOYEE
  body          String   @db.Text // supports {{placeholders}}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issued IssuedCertificate[]

  @@unique([schoolId, name])
}

model IssuedCertificate {
  id            String              @id @default(cuid())
  schoolId      String
  serialNo      String
  templateId    String
  template      CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipientType String
  recipientId   String
  recipientName String
  content       String              @db.Text // rendered snapshot; never re-rendered
  verifyCode    String              @unique // public verification via QR
  issuedOn      DateTime            @db.Date
  issuedById    String
  revokedAt     DateTime?
  createdAt     DateTime            @default(now())

  @@unique([schoolId, serialNo])
  @@index([schoolId, recipientId])
}

// ============================ STUDENT ENGAGEMENT =============================

model Activity {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  category    String // SPORTS | ARTS | CLUB | STEM | COMMUNITY
  description String?  @db.Text
  inchargeId  String?
  schedule    String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members ActivityMember[]

  @@unique([schoolId, name])
}

model ActivityMember {
  id          String   @id @default(cuid())
  schoolId    String
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId   String
  status      String   @default("ENROLLED") // ENROLLED | WAITLISTED | LEFT
  achievement String?
  createdAt   DateTime @default(now())

  @@unique([activityId, studentId])
  @@index([schoolId, studentId])
}

model StudySession {
  id          String   @id @default(cuid())
  schoolId    String
  userId      String
  subject     String?
  minutes     Int
  completedAt DateTime @default(now())

  @@index([schoolId, userId, completedAt])
}

model Doubt {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  askedById      String
  subjectId      String?
  question       String   @db.Text
  answer         String?  @db.Text
  answeredById   String?
  answeredByName String?
  status         String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, studentId])
}

model AiUsage {
  id       String @id @default(cuid())
  schoolId String
  userId   String
  day      String // YYYY-MM-DD
  tokens   Int    @default(0)
  requests Int    @default(0)

  @@unique([schoolId, userId, day])
}

// ======================= MOBILE PUSH ==========================================

/// Web Push subscription for the installable app (one per browser/device).
model PushSubscription {
  id         String    @id @default(cuid())
  schoolId   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique @db.VarChar(512)
  p256dh     String    @db.VarChar(200)
  auth       String    @db.VarChar(100)
  userAgent  String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([schoolId, userId])
}

// ======================= HOSTEL ===============================================

model Hostel {
  id        String       @id @default(cuid())
  schoolId  String
  name      String
  kind      String // BOYS | GIRLS | MIXED
  wardenId  String? // Employee
  address   String?
  phone     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  rooms     HostelRoom[]

  @@unique([schoolId, name])
}

model HostelRoom {
  id          String             @id @default(cuid())
  schoolId    String
  hostelId    String
  hostel      Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  roomNo      String
  floor       String?
  roomType    String?
  capacity    Int
  monthlyFee  Decimal            @default(0) @db.Decimal(12, 2)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  allocations HostelAllocation[]

  @@unique([schoolId, hostelId, roomNo])
}

/// A student's bed in a room. Only one ACTIVE allocation per student (enforced in code); history is kept.
model HostelAllocation {
  id        String     @id @default(cuid())
  schoolId  String
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roomId    String
  room      HostelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNo     String?
  fromDate  DateTime   @db.Date
  toDate    DateTime?  @db.Date
  status    String     @default("ACTIVE") // ACTIVE | VACATED
  notes     String?
  createdAt DateTime   @default(now())

  @@index([schoolId, studentId, status])
  @@index([schoolId, roomId, status])
}

// ======================= GATE & VISITORS ======================================

model Visitor {
  id          String    @id @default(cuid())
  schoolId    String
  passNo      String
  name        String
  phone       String
  purpose     String // MEETING | ADMISSION | PARENT | DELIVERY | VENDOR | INTERVIEW | OTHER
  whomToMeet  String?
  personCount Int       @default(1)
  idProof     String? // type + last digits only, e.g. "Aadhaar 1234"
  vehicleNo   String?
  notes       String?
  inAt        DateTime  @default(now())
  outAt       DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([schoolId, passNo])
  @@index([schoolId, inAt])
}

/// Early-leave pass for a student collected by a parent or authorised person.
model GatePass {
  id           String    @id @default(cuid())
  schoolId     String
  passNo       String
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason       String
  pickedUpBy   String
  relation     String
  pickerPhone  String?
  status       String    @default("ISSUED") // ISSUED | LEFT | CANCELLED
  issuedById   String
  issuedByName String
  issuedAt     DateTime  @default(now())
  outAt        DateTime?

  @@unique([schoolId, passNo])
  @@index([schoolId, issuedAt])
}

// ======================= DISCIPLINE & REMARKS =================================

model DisciplineIncident {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  incidentDate    DateTime  @db.Date
  category        String
  severity        String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  title           String
  description     String    @db.Text
  actionTaken     String?   @db.Text
  status          String    @default("OPEN") // OPEN | ACTION_TAKEN | RESOLVED
  visibleToFamily Boolean   @default(true)
  reportedById    String
  reportedByName  String
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, incidentDate])
}

/// Teacher remarks; REPORT_CARD remarks (one per student per exam) print on the report card.
model StudentRemark {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId          String?
  category        String   @default("GENERAL") // REPORT_CARD | GENERAL | ACADEMIC | CONDUCT
  text            String   @db.Text
  visibleToFamily Boolean  @default(true)
  authorId        String
  authorName      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, studentId])
  @@unique([studentId, examId, category])
  @@index([schoolId, examId])
}

// ======================= ONLINE EXAMS =========================================

model OnlineExam {
  id               String   @id @default(cuid())
  schoolId         String
  title            String
  instructions     String?  @db.Text
  classId          String
  sectionId        String?
  subjectId        String
  startsAt         DateTime
  endsAt           DateTime
  durationMins     Int
  /// Snapshot of the questions when written: [{id,type,text,options,answer,marks}].
  questions        Json
  totalMarks       Decimal  @db.Decimal(7, 2)
  negativeMarks    Decimal  @default(0) @db.Decimal(5, 2) // deducted per wrong objective answer
  shuffle          Boolean  @default(true)
  status           String   @default("DRAFT") // DRAFT | PUBLISHED
  resultsPublished Boolean  @default(false)
  createdById      String
  createdByName    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attempts OnlineExamAttempt[]

  @@index([schoolId, classId, startsAt])
}

model OnlineExamAttempt {
  id          String     @id @default(cuid())
  schoolId    String
  examId      String
  exam        OnlineExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  order       Json // question ids in the order shown to this student
  answers     Json? // { [questionId]: string }
  manualMarks Json? // { [questionId]: number } for descriptive answers
  startedAt   DateTime   @default(now())
  deadline    DateTime
  submittedAt DateTime?
  autoScore   Decimal?   @db.Decimal(7, 2)
  score       Decimal?   @db.Decimal(7, 2)
  status      String     @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | GRADED

  @@unique([examId, studentId])
  @@index([schoolId, studentId])
}

// ======================= ENGAGEMENT: POLLS, FORMS, DISCUSSION, GALLERY, BLOG ==

/// Polls, surveys and custom forms. `audience` = { roles: Role[], classIds: string[] }.
model Form {
  id             String         @id @default(cuid())
  schoolId       String
  title          String
  description    String?        @db.Text
  kind           String         @default("POLL") // POLL | SURVEY | FORM
  fields         Json
  audience       Json
  anonymous      Boolean        @default(false)
  allowEdit      Boolean        @default(false)
  resultsVisible String         @default("AFTER_RESPONSE") // AFTER_RESPONSE | CREATOR_ONLY
  status         String         @default("OPEN") // DRAFT | OPEN | CLOSED
  closesAt       DateTime?
  createdById    String
  createdByName  String
  createdAt      DateTime       @default(now())
  responses      FormResponse[]

  @@index([schoolId, status])
}

model FormResponse {
  id        String   @id @default(cuid())
  schoolId  String
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId    String // kept for one-response-per-person even when anonymous; never shown then
  userName  String
  userRole  String
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, userId])
  @@index([schoolId])
}

model DiscussionTopic {
  id         String           @id @default(cuid())
  schoolId   String
  title      String
  body       String           @db.Text
  audience   Json
  pinned     Boolean          @default(false)
  locked     Boolean          @default(false)
  authorId   String
  authorName String
  authorRole String
  postCount  Int              @default(0)
  lastPostAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  posts      DiscussionPost[]

  @@index([schoolId, lastPostAt])
}

model DiscussionPost {
  id         String          @id @default(cuid())
  schoolId   String
  topicId    String
  topic      DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  body       String          @db.Text
  authorId   String
  authorName String
  authorRole String
  createdAt  DateTime        @default(now())
  editedAt   DateTime?
  removedAt  DateTime?
  removedBy  String?

  @@index([schoolId, topicId, createdAt])
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  schoolId    String
  title       String
  description String?        @db.Text
  eventDate   DateTime?      @db.Date
  visibility  String         @default("ALL") // ALL | STAFF
  coverFileId String?
  createdById String
  createdAt   DateTime       @default(now())
  photos      GalleryPhoto[]

  @@index([schoolId, eventDate])
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  schoolId  String
  albumId   String
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  fileId    String
  caption   String?
  createdAt DateTime     @default(now())

  @@index([schoolId, albumId])
}

model BlogPost {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  slug        String
  excerpt     String?   @db.Text
  body        String    @db.MediumText
  coverFileId String?
  status      String    @default("DRAFT") // DRAFT | PENDING | PUBLISHED | REJECTED
  isPublic    Boolean   @default(false) // also shown on the school's public news page
  authorId    String
  authorName  String
  authorRole  String
  reviewNote  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, slug])
  @@index([schoolId, status, publishedAt])
}

// ======================= TASKS, DOCUMENTS, REMINDERS ==========================

model Task {
  id            String         @id @default(cuid())
  schoolId      String
  title         String
  description   String?        @db.Text
  priority      String         @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate       DateTime?      @db.Date
  status        String         @default("OPEN") // OPEN | IN_PROGRESS | DONE | CANCELLED
  createdById   String
  createdByName String
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignees     TaskAssignee[]
  comments      TaskComment[]

  @@index([schoolId, status, dueDate])
}

model TaskAssignee {
  id          String    @id @default(cuid())
  schoolId    String
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  userName    String
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | DONE
  completedAt DateTime?

  @@unique([taskId, userId])
  @@index([schoolId, userId])
}

model TaskComment {
  id        String   @id @default(cuid())
  schoolId  String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([schoolId, taskId])
}

model DocFolder {
  id        String     @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime   @default(now())
  documents Document[]

  @@unique([schoolId, name])
}

/// Managed school documents (policies, circulars, licences). `roles` = who may open it.
model Document {
  id             String     @id @default(cuid())
  schoolId       String
  folderId       String?
  folder         DocFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title          String
  description    String?    @db.Text
  fileId         String
  fileName       String
  version        Int        @default(1)
  tags           String?
  roles          Json
  expiresOn      DateTime?  @db.Date
  uploadedById   String
  uploadedByName String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([schoolId, folderId])
}

/// Scheduled reminders. `audience` = { self?: true, roles?: Role[], classIds?: string[] }.
model Reminder {
  id            String    @id @default(cuid())
  schoolId      String
  title         String
  message       String    @db.Text
  remindAt      DateTime
  repeat        String    @default("NONE") // NONE | DAILY | WEEKLY | MONTHLY
  audience      Json
  channels      Json // ["APP","SMS","EMAIL"]; APP also reaches installed phones
  status        String    @default("SCHEDULED") // SCHEDULED | SENT | CANCELLED
  sentCount     Int       @default(0)
  lastSentAt    DateTime?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([status, remindAt])
  @@index([schoolId, remindAt])
}

/// Saved custom report definitions (Report builder).
model SavedReport {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  entity        String
  columns       Json
  filters       Json
  shared        Boolean  @default(false)
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@index([schoolId])
}

// ======================= ALUMNI & PLACEMENTS ==================================

model Alumnus {
  id               String   @id @default(cuid())
  schoolId         String
  studentId        String?  @unique
  student          Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  name             String
  passingYear      Int
  lastClass        String?
  email            String?
  phone            String?
  currentStatus    String? // STUDYING | EMPLOYED | SELF_EMPLOYED | OTHER
  organisation     String?
  designation      String?
  higherEducation  String?
  city             String?
  linkedinUrl      String?
  achievements     String?  @db.Text
  consentToContact Boolean  @default(true)
  isMentor         Boolean  @default(false)
  status           String   @default("APPROVED") // PENDING (self-registered) | APPROVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([schoolId, passingYear])
}

model PlacementDrive {
  id               String                 @id @default(cuid())
  schoolId         String
  company          String
  role             String
  description      String?                @db.Text
  location         String?
  packageInfo      String?
  driveDate        DateTime?              @db.Date
  applyBy          DateTime?              @db.Date
  eligibleClassIds Json?
  status           String                 @default("OPEN") // OPEN | CLOSED | COMPLETED
  createdAt        DateTime               @default(now())
  applications     PlacementApplication[]

  @@index([schoolId, status])
}

model PlacementApplication {
  id        String         @id @default(cuid())
  schoolId  String
  driveId   String
  drive     PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String         @default("APPLIED") // APPLIED | SHORTLISTED | SELECTED | REJECTED | WITHDRAWN
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([driveId, studentId])
  @@index([schoolId, studentId])
}
