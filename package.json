{
  "name": "vidyalaya-school-erp",
  "version": "2.0.0",
  "description": "Multi-tenant School ERP SaaS for Indian schools",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "tsx tests/api/run.ts",
    "test:e2e": "playwright test",
    "docs:pdf": "node scripts/generate-pdf-guide.js",
    "platform:operator": "tsx prisma/create-operator.ts",
    "website:screens": "node scripts/website-screens.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-alert-dialog": "1.2.1",
