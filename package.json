    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "^3.6.3",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.4.0",
    "prisma": "5.22.0",
