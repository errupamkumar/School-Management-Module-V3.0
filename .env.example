# ---------------------------------------------------------------------------
# Vidyalaya ERP — environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL 8 database (one database holds every school; rows are tenant-scoped)
DATABASE_URL="mysql://user:password@localhost:3306/vidyalaya_saas"

# Session signing secret — REQUIRED in production. Generate: openssl rand -base64 48
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Field-level encryption (Aadhaar, SMS/WhatsApp/Razorpay credentials) — REQUIRED in production.
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Keep a secure backup: data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY=""

# Uploaded files are stored OUTSIDE the web root and served through access checks
STORAGE_DIR="./storage"
MAX_FILE_SIZE=5242880

# Online fee payments. Each school can also enter its own Razorpay keys in Settings
# (money then settles to the school); these platform keys are the fallback.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Local demo only: simulate the gateway (ignored in production builds)
PAYMENT_SANDBOX="0"

# AI assistant — set ONE provider. Claude is preferred; Gemini is supported.
ANTHROPIC_API_KEY=""
# Default claude-opus-5-5; claude-sonnet-5-5 or claude-haiku-5-5 cost less
AI_MODEL=""
GEMINI_API_KEY=""
# Comma-separated fallbacks, tried in order when a model is overloaded
GEMINI_MODEL="gemini-flash-latest,gemini-flash-lite-latest"

# Demo / seeding
# Shows demo-account shortcuts on the login page. Leave unset in production.
NEXT_PUBLIC_DEMO_MODE=""
# Password for all seeded demo accounts (default Demo@12345)
SEED_PASSWORD=""
# The seed refuses to run when NODE_ENV=production unless this is 1
SEED_ALLOW_DEMO=""

# Phone notifications (installable app). Generate once per deployment: npx web-push generate-vapid-keys
# Keep the private key secret; changing the keys requires every device to re-enable notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@your-domain.in"

# Scheduler: call POST /api/public/cron every minute with "Authorization: Bearer <CRON_SECRET>"
# (reminders). Use 16+ random characters. Without it, due reminders go out when users are active.
CRON_SECRET=""

# Single sign-on (optional). Register one OAuth app per provider for the whole platform;
# schools then switch SSO on in School Settings → Integrations & data.
# Redirect URIs: <NEXTAUTH_URL>/api/auth/callback/google and <NEXTAUTH_URL>/api/auth/callback/azure-ad
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# "organizations" accepts any work/school Microsoft account; or set one tenant id.
AZURE_AD_TENANT_ID="organizations"
